# Configure your model provider using ZeroClaw's v0.8.x environment-variable
# grammar. Example for OpenRouter:
# ZEROCLAW_providers__models__openrouter__default__api_key=your_api_key
# ZEROCLAW_providers__models__openrouter__default__model=anthropic/claude-sonnet-4-20250514

# Railway provides PORT automatically. Do not hardcode it here.
# Browser automation is enabled by default in this deployment.
ZEROCLAW_browser__automation_enabled=true
ZEROCLAW_browser__backend=agent_browser
ZEROCLAW_browser__headed=false

# Recommended: restrict browser navigation to trusted domains.
# Supply a TOML/JSON-compatible array string, for example:
# ZEROCLAW_browser__allowed_domains=["github.com","google.com","docs.zeroclaw.com"]

# Keep the gateway pairing requirement enabled.
ZEROCLAW_gateway__require_pairing=true
